# ---------------------------------------------------------------------------
# Copy to .env and fill in what you have. EVERY key below is optional except
# DATABASE_URL — the app runs with zero AI keys (Ollama-only) by design.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Serve recorded fixtures instead of calling any provider.
# Use for CI, offline work, and as demo-day insurance.
DEMO=false

# ---------------------------------------------------------------------------
# Database — local Postgres OR Neon. Switching is this one line, no code change.
# ---------------------------------------------------------------------------

# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_assist

# Neon (https://neon.tech — free, no card). Use the POOLED host here:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# ...and the DIRECT (unpooled) host here. drizzle-kit migrations fail on the pooler.
# DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Note: Neon's free tier suspends after ~5 min idle, so the first query costs ~1s.
# Hit /api/v1/health/ready to warm it before a demo.

# ---------------------------------------------------------------------------
# AI providers. All optional: a missing key drops that provider from the
# failover chain.
#
# Every provider is a hosted service, so with NO keys at all the server still
# starts but every analysis fails with ALL_PROVIDERS_FAILED. Set at least one.
# Gemini is the one to start with — it alone reads PDFs and photographs.
# ---------------------------------------------------------------------------

# https://aistudio.google.com/apikey  — primary. Only provider with native PDF/image input.
GEMINI_API_KEY=

# https://console.groq.com/keys  — fast, but 6,000 tokens/min on free tier,
# so it only serves per-clause stages, never whole-document analysis.
GROQ_API_KEY=

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# https://ollama.com/settings/keys  — hosted API, last in the failover chain.
# Cloud only: there is no local daemon mode.
OLLAMA_API_KEY=

# Optional model override. This catalogue changes faster than anything else
# here, so a wrong tag is a one-line fix rather than a redeploy.
#
#   curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/v1/models
#
# lists what your key can reach. A LOCAL tag like "llama3.2" is not a cloud
# model, and the hosted API answers an unavailable model with 401 Unauthorized
# rather than 404 — which looks like a bad key and is not.
# Default: gpt-oss:120b
OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# Cloudinary (https://cloudinary.com — free tier). Optional.
# Without these, documents are processed in memory and never stored.
# ---------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
